---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import { site } from '../../site';

const events = [
  { href: '/events/weddings/', title: 'Weddings', text: 'Beat noise curfews and keep every generation on the floor.' },
  { href: '/events/corporate/', title: 'Corporate events', text: 'Holiday parties, offsites, and conference after-hours.' },
  { href: '/events/parties/', title: 'Parties & more', text: 'Birthdays, school dances, church events, bars, and silent yoga.' },
];
---

<Base title="Silent Disco Events We Serve" description={`Silent disco for weddings, corporate events, birthdays, school dances, and more across the ${site.areaShort}.`}>
  <section class="hero hero-sub">
    <div class="wrap">
      <p class="eyebrow">Events</p>
      <h1>Silent disco for every kind of event</h1>
      <p class="lead">If people want to dance, a silent disco works. Here are the events we do most.</p>
    </div>
  </section>
  <section class="section-tight">
    <div class="wrap grid grid-3">
      {events.map((e) => (
        <a class="card" href={e.href}>
          <h3>{e.title}</h3>
          <p class="muted">{e.text}</p>
        </a>
      ))}
    </div>
  </section>
  <section class="section">
    <div class="wrap grid grid-2" style="align-items: center;">
      <video class="video-tall" autoplay muted loop playsinline preload="metadata" poster="/images/dance-floor-clip-poster.webp" aria-label="Guests dancing in LED headsets on a brick-walled dance floor">
        <source src="/videos/dance-floor-clip.mp4" type="video/mp4" />
      </video>
      <div>
        <h2>Same gear, any room</h2>
        <p class="muted">Bar, ballroom, backyard, or beach. The headsets do the work, so the venue can be anything with an outlet.</p>
        <p><a href="/rentals/">See what's included</a></p>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
