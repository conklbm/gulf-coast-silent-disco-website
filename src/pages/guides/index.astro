---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getCollection } from 'astro:content';

const guides = (await getCollection('guides')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base title="Silent Disco Guides" description="Practical guides on planning a silent disco: how it works, how many headphones to rent, wedding tips, and more.">
  <section class="hero hero-sub">
    <div class="wrap">
      <p class="eyebrow">Guides</p>
      <h1>Silent disco planning guides</h1>
      <p class="lead">Everything we get asked, written down.</p>
    </div>
  </section>
  <section class="section-tight">
    <div class="wrap grid grid-2">
      {guides.map((g) => (
        <a class="card" href={`/guides/${g.id}/`}>
          <h3>{g.data.title}</h3>
          <p class="muted">{g.data.description}</p>
          <p class="post-meta" style="margin: 0.75rem 0 0;">{fmt(g.data.date)}</p>
        </a>
      ))}
    </div>
  </section>
  <CtaBand />
</Base>
